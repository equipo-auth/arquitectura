# Puerto estàndar de la aplicaciòn
PORT=3000

# Entorno por defecto
NODE_ENV=development

# Estructura de la URL de Neon
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/ticketu?schema=public"

# Configuraciones de Keycloak
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="ticketu-realm"
KEYCLOAK_CLIENT_ID="ticketu-backend"
KEYCLOAK_CLIENT_SECRET="tu-secreto-aqui"
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# RabbitMQ (local: 5672 | CloudAMQP: amqps://usuario:password@servidor.cloudamqp.com/vhost)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_AUTH_EXCHANGE=auth.events
RABBITMQ_NOTIFICACIONES_EXCHANGE=notificaciones.events
RABBITMQ_AUTH_INBOUND_QUEUE=auth.correo_auth

# HU-B4: vigencia del enlace de bienvenida /crear-clave
STAFF_INVITE_TOKEN_TTL_HOURS=72

# URL del Front
FRONTEND_URL=https://tu-sitio.netlify.app

# Clave para servicios internos (x-api-key): /internal/* y /api/auth/provision
INTERNAL_API_KEY=proyecto_titec_123

# Saltos de proxy confiables (Gateway/balanceador) para la IP real en el rate limit
TRUST_PROXY_HOPS=1

# Json Web Tokens
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
