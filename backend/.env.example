# TITEC / TicketU - Auth | Plantilla de desarrollo local
# Copiar a backend/.env y adaptar las credenciales privadas antes de iniciar.
# Nunca subir backend/.env, private.pem ni claves reales al repositorio.
# Este archivo define la ejecucion NATIVA de NestJS; los Compose de Docker
# sustituyen DATABASE_URL, KEYCLOAK_URL y RABBITMQ_URL por nombres de contenedor.

# Aplicacion
NODE_ENV=development
PORT=10000

# PostgreSQL de Auth (host: 5433; contenedor: 5432)
DATABASE_URL="postgresql://admin:adminpassword@localhost:5433/ticketu?schema=public"

# Keycloak local (host: 8081; contenedor: 8080)
KEYCLOAK_URL="http://localhost:8081"
KEYCLOAK_REALM="ticketu-realm"
KEYCLOAK_CLIENT_ID="ticketu-backend"
KEYCLOAK_CLIENT_SECRET="<CONFIGURAR_EN_ENTORNO>"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

# Frontend local (QA Auth en 3001). Auth genera enlaces /auth/restablecer y /auth/crear-clave.
# EN WORKSTATION con FWizav/FrontendTitec, configurar EN backend/.env (no aqui):
# COMPRADOR_FRONTEND_URL="http://localhost:3000" y FRONTEND_URL="http://localhost:3000"
# El dominio/URL debe ser accesible para quien reciba los enlaces; no siempre localhost.
COMPRADOR_FRONTEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3001"
ENABLE_CORS="true"
TRUST_PROXY_HOPS="0"

# RabbitMQ compartido. No cambiar exchanges ni routing keys contractuales.
RABBITMQ_URL="amqp://ticketu:ticketu_dev@127.0.0.1:5672/ticketu"
RABBITMQ_EXCHANGE_TYPE="topic"
RABBITMQ_AUTH_EXCHANGE="auth.events"
RABBITMQ_NOTIFICACIONES_EXCHANGE="notificaciones.events"
RABBITMQ_AUTH_INBOUND_QUEUE="auth.correo_auth"
STAFF_INVITE_TOKEN_TTL_HOURS=72

# Clave compartida acordada SOLO para el entorno de QA local.
# Debe coincidir con la de los demas backends autorizados (cabecera x-api-key).
# Sustituir por una clave aleatoria privada antes de cualquier despliegue accesible.
# Nunca llevarla a variables NEXT_PUBLIC_ ni VITE_.
INTERNAL_API_KEY="CAMBIAR_CLAVE_COMPARTIDA_SEGURA"

# Operaciones sensibles de revocacion: secreto independiente de minimo 32 caracteres.
AUTH_OPERATIONS_KEY="<CONFIGURAR_EN_ENTORNO>"
JWT_KEY_GRACE_HOURS=24

# JWT RS256: llaves en backend/private.pem y backend/public.pem,
# no en variables JWT_PRIVATE_KEY ni JWT_PUBLIC_KEY de este ejemplo.

# Sincronizacion Keycloak -> PostgreSQL
KEYCLOAK_SYNC_ENABLED="true"
KEYCLOAK_SYNC_INTERVAL_MS="30000"
STAFF_INVITATION_WORKER_MS="10000"

# SOLO demo local; nunca registrar URLs con tokens en produccion.
DEMO_LOG_INVITATION_URL="false"
