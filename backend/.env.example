# Configuración local: NestJS se ejecuta con npm, infra en Docker.
NODE_ENV=development
PORT=10000
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/ticketu?schema=public"

KEYCLOAK_URL="http://localhost:8081"
KEYCLOAK_REALM="ticketu-realm"
KEYCLOAK_CLIENT_ID="ticketu-backend"
KEYCLOAK_CLIENT_SECRET="CONFIGURAR_SECRETO_REAL"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

COMPRADOR_FRONTEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000" # En 5173 solo cuando Panel implemente /crear-clave
ENABLE_CORS="true"
TRUST_PROXY_HOPS="0"

# Contractual: NO cambiar exchanges ni routing keys
RABBITMQ_URL="amqp://ticketu:ticketu_dev@127.0.0.1:5672/ticketu"
RABBITMQ_EXCHANGE_TYPE="topic"
RABBITMQ_AUTH_EXCHANGE="auth.events"
RABBITMQ_NOTIFICACIONES_EXCHANGE="notificaciones.events"
RABBITMQ_AUTH_INBOUND_QUEUE="auth.correo_auth"
STAFF_INVITE_TOKEN_TTL_HOURS=72
# Clave compartida entre TODOS los backends consumidores autorizados de este entorno.
# Genera un secreto nuevo con: openssl rand -hex 32
# No publicar en NEXT_PUBLIC_ / VITE_, ni subir el .env al repositorio.
INTERNAL_API_KEY="CAMBIAR_CLAVE_COMPARTIDA_SEGURA"

# Las llaves RS256 son archivos privados en backend/private.pem y backend/public.pem

# Sincronización periódica Keycloak -> PostgreSQL; ningún ADMIN extra.
KEYCLOAK_SYNC_ENABLED="true"
KEYCLOAK_SYNC_INTERVAL_MS="30000"
# En intervalos más cortos para publicar invitaciones pendientes incluso con RabbitMQ caído.
STAFF_INVITATION_WORKER_MS="10000"

# Auditoria: se guarda en PostgreSQL (audit_logs) y se ve en consola.
# Solo para una demo LOCAL; imprime URL secreta después de publicar en RabbitMQ.
# NO activar en producción y NO redirigir la consola a logs públicos.
DEMO_LOG_INVITATION_URL="false"
