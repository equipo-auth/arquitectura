    {
      "name": "02 - Login (MANUAL, riesgo de bloqueo)",
      "description": "HU-AUTH-02. Usar cuenta propia. Bloqueo tras cinco fallos es manual y autorizado, no incluido en Runner.",
      "item": [
        {
          "name": "TC-LOG-01 Login correcto — 200 + token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "let b={}; try{b=pm.response.json()}catch(e){} pm.test(\"Campo token presente\",()=>pm.expect(b.token).to.be.a(\"string\").and.not.empty); if(pm.response.code===200 && typeof b.token===\"string\") pm.collectionVariables.set(\"authToken\",b.token);"
                ]
              }
            }
          ],
          "description": "Rellena loginEmail y loginPassword LOCALMENTE en Postman, luego limpia variable authToken antes de exportar."
        },
        {
          "name": "TC-LOG-04 Clave incorrecta — 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
