# Local directo (para producción use API Gateway en NEXT_PUBLIC_AUTH_API_URL)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_API_URL=http://localhost:10000
NEXT_PUBLIC_PANEL_URL=http://localhost:3001

# URLs de las INTERFACES web de los otros equipos (no puertos de sus APIs).
# Si quedan vacías, redirige a /checkin, /organizador y /entradas del front común.
# Ejemplos para una integración donde cada equipo publica su propia web:
# NEXT_PUBLIC_CHECKIN_APP_URL=http://localhost:PUERTO_WEB_CHECKIN/
# NEXT_PUBLIC_ORGANIZADOR_APP_URL=http://localhost:5173/
# NEXT_PUBLIC_ENTRADAS_APP_URL=http://localhost:PUERTO_WEB_ENTRADAS/
NEXT_PUBLIC_CHECKIN_APP_URL=
NEXT_PUBLIC_ORGANIZADOR_APP_URL=
NEXT_PUBLIC_ENTRADAS_APP_URL=
